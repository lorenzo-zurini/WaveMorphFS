# AppArmor profile for the WaveMorphFS container: Docker's default profile
# (docker-default, moby profiles/apparmor/template.go) with one change. Instead
# of denying every mount it allows exactly the FUSE mount WaveMorphFS makes, so
# the container no longer needs apparmor:unconfined.
#
# Load it on the host once (and keep it across reboots):
#   sudo cp apparmor-wavemorphfs /etc/apparmor.d/wavemorphfs
#   sudo apparmor_parser -r -W /etc/apparmor.d/wavemorphfs
# then start the container with security_opt: apparmor=wavemorphfs.

#include <tunables/global>

profile wavemorphfs flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  network,
  capability,
  file,
  umount,
  # Host (privileged) processes may send signals to container processes.
  signal (receive) peer=unconfined,
  # runc/crun may send signals to container processes (for "docker stop").
  signal (receive) peer=runc,
  signal (receive) peer=crun,
  # dockerd may send signals to container processes (for "docker kill").
  signal (receive) peer=dockerd-default,
  # Container processes may send signals amongst themselves.
  signal (send,receive) peer=wavemorphfs,

  deny @{PROC}/* w,   # deny write for all files directly in /proc (not in a subdir)
  # deny write to files not in /proc/<number>/** or /proc/sys/**
  deny @{PROC}/{[^1-9],[^1-9][^0-9],[^1-9s][^0-9y][^0-9s],[^1-9][^0-9][^0-9][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,  # deny /proc/sys except /proc/sys/k* (effectively /proc/sys/kernel)
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,  # deny everything except shm* in /proc/sys/kernel/
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,

  # docker-default has "deny mount," here. A deny rule would override any
  # allow, so it is replaced by the one mount fusermount3 makes for
  # WaveMorphFS (fsname/subtype set in fs.cpp); every other mount stays denied.
  mount fstype=fuse.wavemorphfs,

  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,

  # suppress ptrace denials when using 'docker ps' or using 'ps' inside a container
  ptrace (trace,read,tracedby,readby) peer=wavemorphfs,
}
